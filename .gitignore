# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Python
__pycache__/
*.pyc

# Runtime-generated config reload status (see config.h/config.c)
*.json.status

# Build
build/
builddir/
dist/
notes/
build-dbg/
build-rel/

# meson subprojects: only the .wrap files (which fetch these on demand) are
# tracked; the extracted/downloaded source trees they point at are not.
subprojects/*
!subprojects/*.wrap
!subprojects/packagefiles/
